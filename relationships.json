  "query_examples": {
    "machines_with_lines": "SELECT m.machine_name, m.status, pl.line_name FROM machines m JOIN line_machines lm ON m.machine_id = lm.machine_id JOIN production_lines pl ON lm.line_id = pl.line_id",
    "sensors_with_machines": "SELECT s.sensor_id, s.model_number, m.machine_name FROM sensors s JOIN machine_sensors ms ON s.sensor_id = ms.sensor_id JOIN machines m ON ms.machine_id = m.machine_id",
    "employees_with_roles": "SELECT e.first_name, e.last_name, jr.role_name FROM employees e JOIN job_roles jr ON e.role_id = jr.role_id",
    "plants_with_regions": "SELECT p.plant_name, p.status, r.region_name FROM plants p JOIN regions r ON p.region_id = r.region_id",
    "fault_machines_with_lines": "SELECT m.machine_name, m.status, pl.line_name FROM machines m JOIN line_machines lm ON m.machine_id = lm.machine_id JOIN production_lines pl ON lm.line_id = pl.line_id WHERE m.status = 'Fault'",
    "maintenance_for_plant": "SELECT mr.request_type, mr.description, mr.request_time, m.machine_name FROM maintenance_requests mr JOIN machines m ON mr.machine_id = m.machine_id JOIN line_machines lm ON m.machine_id = lm.machine_id JOIN production_lines pl ON lm.line_id = pl.line_id JOIN plants p ON pl.plant_id = p.plant_id WHERE p.plant_name ILIKE '%Tesla%'",
    "sensor_readings_recent": "SELECT sr.sensor_id, sr.value, sr.timestamp FROM sensor_readings sr WHERE sr.timestamp > NOW() - INTERVAL '24 hours' LIMIT 10",
    "plants_per_region": "SELECT r.region_name, COUNT(p.plant_id) AS plant_count FROM regions r JOIN plants p ON r.region_id = p.region_id GROUP BY r.region_name"
  }
