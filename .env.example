# Database Configuration
CORE_DB_URL=postgresql://postgres:password@localhost:5432/your_database
DB_SCHEMA=public

# LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# API Configuration
BACKEND_API_KEY=your-secret-key-change-this-in-production
PORT=8000
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# Database Pool (Advanced)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_BASE=2.0

# Feature Flags
AUTO_INDEX_ON_STARTUP=true
ENABLE_HEALTH_ENDPOINT=true
